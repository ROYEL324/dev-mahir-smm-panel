# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-Side SMM Provider API Credentials (NEVER expose to frontend)
SMM_PROVIDER_API_URL=""
SMM_PROVIDER_API_KEY=""

# Server-Side Payment Gateway Secrets (bKash / Nagad - NEVER expose to frontend)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_KEY=""
